{
    "name": "tastysoul/changelog-checker",
    "type": "composer-plugin",
    "description": "Composer plugin to check changelog files for breaking changes",
    "keywords": [
        "php",
        "package",
        "changelog",
        "breaking changes"
    ],
    "readme": "README.md",
    "autoload": {
        "psr-4": {
            "TastySoul\\ChangelogChecker\\": "src/"
        }
    },
    "require": {
        "ext-ctype": "*",
        "composer-plugin-api": "^2.0"
    },
    "require-dev": {
        "composer/composer": "^2.0",
        "phpstan/phpstan": "^2.2"
    },
    "extra": {
        "class": "TastySoul\\ChangelogChecker\\ChangelogCheckerPlugin",
        "changelog-checker": {
            "plugins": []
        }
    }
}
